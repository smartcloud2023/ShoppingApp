<mxfile host="app.diagrams.net"><diagram id="devsecops" name="DevSecOps pipeline"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1020" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="E-commerce DevSecOps pipeline: cheap checks first, only signed images reach prod" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="940" height="34" as="geometry"/></mxCell><mxCell id="start" value="Push or&lt;br&gt;pull request" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="130" height="64" as="geometry"/></mxCell><mxCell id="gates" value="1 · Security gates (run in parallel)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#FEF6F6;strokeColor=#EBA3A3;fontColor=#1B1F24;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="70" width="230" height="530" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Gitleaks&lt;/b&gt;&lt;br&gt;&lt;small&gt;secrets in full git history&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="gates"><mxGeometry x="20" y="50" width="190" height="70" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;SonarQube SAST&lt;/b&gt;&lt;br&gt;&lt;small&gt;quality gate must pass&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="gates"><mxGeometry x="20" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;OWASP Dependency-Check&lt;/b&gt;&lt;br&gt;&lt;small&gt;SCA · fails on CVSS ≥ 7&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="gates"><mxGeometry x="20" y="290" width="190" height="70" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;Trivy fs + IaC&lt;/b&gt;&lt;br&gt;&lt;small&gt;CVEs · secrets · Dockerfile, Helm&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="gates"><mxGeometry x="20" y="410" width="190" height="70" as="geometry"/></mxCell><mxCell id="build" value="2 · Build, scan, sign (24 images)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F6F9FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="230" height="530" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Build image&lt;/b&gt;&lt;br&gt;&lt;small&gt;local only, nothing pushed&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="build"><mxGeometry x="20" y="45" width="190" height="64" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Trivy image gate&lt;/b&gt;&lt;br&gt;&lt;small&gt;fixable HIGH / CRITICAL&lt;/small&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;fontSize=14;" vertex="1" parent="build"><mxGeometry x="15" y="135" width="200" height="90" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;SBOM&lt;/b&gt;&lt;br&gt;&lt;small&gt;CycloneDX, kept 90 days&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="build"><mxGeometry x="20" y="250" width="190" height="64" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Push to ECR&lt;/b&gt;&lt;br&gt;&lt;small&gt;main only · immutable SHA tag&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="build"><mxGeometry x="20" y="340" width="190" height="64" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;cosign sign + attest&lt;/b&gt;&lt;br&gt;&lt;small&gt;keyless, by digest&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="build"><mxGeometry x="20" y="430" width="190" height="64" as="geometry"/></mxCell><mxCell id="deploy" value="3 · Deploy and test" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F3FAF5;strokeColor=#8BCB9F;fontColor=#1B1F24;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="70" width="230" height="530" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;cosign verify&lt;/b&gt;&lt;br&gt;&lt;small&gt;only our signed images&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="deploy"><mxGeometry x="20" y="45" width="190" height="64" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Helm → dev&lt;/b&gt;&lt;br&gt;&lt;small&gt;rolls back if pods fail&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="deploy"><mxGeometry x="20" y="125" width="190" height="64" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Smoke + ZAP DAST&lt;/b&gt;&lt;br&gt;&lt;small&gt;health, headers, baseline scan&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="deploy"><mxGeometry x="20" y="205" width="190" height="64" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;Staging&lt;/b&gt;&lt;br&gt;&lt;small&gt;1 approver&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="deploy"><mxGeometry x="20" y="300" width="190" height="64" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;Prod&lt;/b&gt;&lt;br&gt;&lt;small&gt;2 approvers + wait timer&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="deploy"><mxGeometry x="20" y="400" width="190" height="64" as="geometry"/></mxCell><mxCell id="stop" value="&lt;b&gt;Pipeline stops&lt;/b&gt; · findings go to the GitHub Security tab (SARIF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="210" y="650" width="500" height="56" as="geometry"/></mxCell><mxCell id="vault" value="&lt;b&gt;HashiCorp Vault via GitHub OIDC&lt;/b&gt; · each job gets a 10 to 20 minute token: scanners read the Sonar token and NVD key, builders the ECR role, each environment only its own deploy credentials. Nothing stored in GitHub." style="whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=14;rounded=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="940" height="56" as="geometry"/></mxCell><mxCell id="legend" value="Red dashed = stops the pipeline · Pull requests run stages 1 and 2 only, nothing is pushed · Every action pinned to a commit SHA · each job gets only the permissions it needs" style="rounded=1;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;html=1;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="815" width="940" height="44" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="start" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="start" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="start" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="start" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="all pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#1E7F3E;labelBackgroundColor=default;" edge="1" parent="1" source="gates" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="build" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="clean" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#1E7F3E;labelBackgroundColor=default;" edge="1" parent="build" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="build" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="build" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b5" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="deploy" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="deploy" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;" edge="1" parent="deploy" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;" edge="1" parent="deploy" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1" value="any finding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#C9302C;fontColor=#C9302C;labelBackgroundColor=default;" edge="1" parent="1" source="gates" target="stop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="vulnerable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#C9302C;fontColor=#C9302C;labelBackgroundColor=default;" edge="1" parent="1" source="b2" target="stop"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
