<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppressions.

  Rules for adding one:
    1. Every suppression needs a reason a reviewer can check.
    2. Every suppression needs an "until" date. When it expires the build
       fails again and someone has to look at it again.
    3. Suppress by package URL + CVE, never a whole package.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

  <!-- Example: false positive, the CPE matches a different product with the same name. -->
  <suppress until="2027-02-28Z">
    <notes><![CDATA[
      False positive. CPE cpe:/a:grpc:grpc matches the C core, we use grpc-java.
      Checked by: Smart, 2026-11-24. Ticket: SEC-142.
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/io\.grpc/grpc\-.*@.*$</packageUrl>
    <cpe>cpe:/a:grpc:grpc</cpe>
  </suppress>

</suppressions>
